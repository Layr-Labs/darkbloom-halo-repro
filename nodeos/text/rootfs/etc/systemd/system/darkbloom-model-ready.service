[Unit]
Description=Check the mounted model before allowing text inference
Requires=usr-share-darkbloom-models.mount
After=usr-share-darkbloom-models.mount
Before=dbnode-engine.service dbnode-llama.service dbnode.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=dbnode
ExecStart=/usr/bin/python3 -I -B /usr/lib/darkbloom/catalog-model.py ready
UMask=0027
LimitCORE=0
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/darkbloom-model
ProtectHome=yes
InaccessiblePaths=/run/nodeos/host
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
CapabilityBoundingSet=
TimeoutStartSec=30
