[Unit]
Description=Export a requested public TPM calibration without networking
After=local-fs.target systemd-modules-load.service systemd-udev-settle.service
OnSuccess=nodeos-return.service

[Service]
Type=oneshot
SupplementaryGroups=tss
ExecStart=/usr/bin/python3 -I -B /usr/lib/darkbloom/offline-calibration.py
RuntimeDirectory=darkbloom-calibration
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/darkbloom-calibration
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
CapabilityBoundingSet=CAP_SYS_ADMIN
StandardError=journal+console
TimeoutStartSec=110
