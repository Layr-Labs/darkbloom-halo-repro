[Unit]
Description=Require TPM-sealed Wi-Fi before networking or inference
Wants=systemd-udev-settle.service
After=local-fs.target systemd-udev-settle.service
Before=NetworkManager.service dbnode-engine.service dbnode-llama.service dbnode.service

[Service]
Type=oneshot
RemainAfterExit=yes
SupplementaryGroups=tss
ExecStart=/usr/bin/python3 -I -B /usr/lib/darkbloom/sealed-wifi-start.py
RuntimeDirectory=NetworkManager/system-connections darkbloom-wifi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/NetworkManager/system-connections /run/darkbloom-wifi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DeviceAllow=/dev/tpmrm0 rw
DevicePolicy=closed
CapabilityBoundingSet=
TimeoutStartSec=150
