[Unit]
Description=Verify the selected signed model and open its dm-verity mapping
After=local-fs.target systemd-udev-settle.service
Before=usr-share-darkbloom-models.mount

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=dbnode
ExecStart=/usr/bin/python3 -I -B /usr/lib/darkbloom/catalog-model.py open
ExecStop=/usr/sbin/veritysetup close nodeos-catalog-model
RuntimeDirectory=darkbloom-model
RuntimeDirectoryMode=0750
UMask=0027
LimitCORE=0
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/darkbloom-model /run/cryptsetup
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/mapper/control rw
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rwm
DeviceAllow=block-device-mapper rwm
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_MKNOD
TimeoutStartSec=180
TimeoutStopSec=30
