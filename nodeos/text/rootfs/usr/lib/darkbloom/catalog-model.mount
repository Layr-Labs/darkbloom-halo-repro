# Installed as usr-share-darkbloom-models.mount only in catalog builds.
[Unit]
Description=Mount the authenticated catalog model
DefaultDependencies=no
Requires=darkbloom-model-open.service
After=local-fs.target darkbloom-model-open.service
Before=umount.target
Conflicts=umount.target

[Mount]
What=/run/darkbloom-model/mapper
Where=/usr/share/darkbloom/models
Type=erofs
Options=ro,nodev,nosuid,noexec
TimeoutSec=30
